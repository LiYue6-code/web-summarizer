{
  "name": "web-summarizer",
  "version": "1.1.0",
  "description": "输入网址，AI 自动提取网页正文并生成中文摘要",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"node server.js\" \"vite\"",
    "dev:server": "node server.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@mozilla/readability": "^0.6.0",
    "antd": "^6.6.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "jsdom": "^30.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "vite": "^8.3.4"
  }
}
